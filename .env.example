APP_ENV=development
APP_URL=http://localhost:8000
DATABASE_URL=postgresql+psycopg://eventface:change-me@db:5432/eventface
POSTGRES_PASSWORD=change-me
GOOGLE_CLIENT_ID=
SESSION_SECRET=replace-with-a-long-random-value
SESSION_COOKIE_DOMAIN=
CORS_ALLOWED_ORIGINS=http://localhost:8000
S3_ENDPOINT=http://minio:9000
S3_BUCKET=eventface-private
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
AI_MODEL_STORAGE_PATH=/models/approved-face-model.onnx
AI_CPU_THREADS=2
AI_MAX_CONCURRENT_JOBS=2
MAX_UPLOAD_SIZE=20971520
SEARCH_RATE_LIMIT=10/minute
DEFAULT_DATA_RETENTION_DAYS=90
